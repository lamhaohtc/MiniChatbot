# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
# Optional: reuse an existing vector store. Leave empty to find-or-create by name.
VECTOR_STORE_ID=
VECTOR_STORE_NAME=optibot-kb
# Zendesk Help Center (public, no auth required)
ZENDESK_BASE_URL=https://support.optisigns.com
ZENDESK_LOCALE=en-us
# 0 = all articles. Set e.g. 40 for a quick local run.
MAX_ARTICLES=0
# Chunking (OpenAI static strategy). Overlap must be <= half of max.
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=400
UPLOAD_CONCURRENCY=4
LOG_LEVEL=INFO
