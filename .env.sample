# Copy to .env and fill in. Never commit .env.

# Which knowledge base to sync into: gemini (default, free tier) or openai.
AI_PROVIDER=gemini

# Gemini: key from aistudio.google.com -> Get API key
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (only if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: reuse an existing store. Gemini: fileSearchStores/...  OpenAI: vs_...
# Leave empty to find-or-create by name.
VECTOR_STORE_ID=
VECTOR_STORE_NAME=optibot-kb

# Zendesk Help Center (public, no auth required)
ZENDESK_BASE_URL=https://support.optisigns.com
ZENDESK_LOCALE=en-us
# 0 = all articles. Set e.g. 40 for a quick local run.
MAX_ARTICLES=0

# Chunking. Gemini counts whitespace tokens (defaults 400/80); OpenAI counts BPE tokens (defaults 800/400).
# Overlap must be <= half of max. Leave blank for the provider default.
CHUNK_MAX_TOKENS=
CHUNK_OVERLAP_TOKENS=
UPLOAD_CONCURRENCY=4
LOG_LEVEL=INFO
